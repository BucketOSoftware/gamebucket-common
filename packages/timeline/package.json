        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    },
    "tsup": {
        "entry": [
            "src/index.ts"
        ],
        "format": [
            "cjs",
            "esm"
        ],
        "platform": "neutral",
        "dts": true,
        "sourcemap": true,
        "clean": true
    }
